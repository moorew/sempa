# Database & runtime data
backend/data/
backend/bin/
backend/aura
backend/server

# Go build artifacts
*.exe
*.test

# Frontend
frontend/build/
frontend/.svelte-kit/
frontend/node_modules/

# Tauri
frontend/src-tauri/target/
frontend/src-tauri/gen/

# Secrets — user-specific, never commit
.env
.env.local
# Allow example templates
!.env.example
!.env.local.example
# Android signing material — CI injects this from secrets.KEYSTORE_BASE64
*.keystore
*.jks

# Editor
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Tailscale
ts-sempa/

# Syncthing
.stfolder/
.stignore
*.sync-conflict-*

# iOS Capacitor project is generated in CI (macOS), not committed —
# config lives in capacitor.config.ts + the ios-release workflow's Plist steps.
frontend/ios/
