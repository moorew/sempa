# Maintainer: Sempa <hello@sempa.ca>
# sempa-bin — installs the released Sempa desktop app (from the GitHub .deb) on
# Arch/Manjaro. Arch users who'd rather build from source can adapt this to fetch
# the source tag and run `tauri build`; -bin keeps installs fast.
pkgname=sempa-bin
pkgver=1.1.3
pkgrel=1
pkgdesc="Calm, self-hosted task manager — plan your day with intention"
arch=('x86_64' 'aarch64')
url="https://sempa.ca"
license=('AGPL-3.0-or-later')
# WebKitGTK 4.1 webview + GTK3; appindicator for the optional tray.
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator')
optdepends=('libsecret: Secret Service keyring for the account token')
provides=('sempa')
conflicts=('sempa')
options=('!strip' '!debug')
_tag="v${pkgver}"
source_x86_64=("${pkgname}-${pkgver}-x86_64.deb::https://github.com/moorew/sempa/releases/download/${_tag}/Sempa_${pkgver}_amd64.deb")
source_aarch64=("${pkgname}-${pkgver}-aarch64.deb::https://github.com/moorew/sempa/releases/download/${_tag}/Sempa_${pkgver}_arm64.deb")
# Replace SKIP with real digests at release time: `updpkgsums` (or sha256sum the
# uploaded .deb). SKIP ships but is rejected by some AUR linters.
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  local deb="${pkgname}-${pkgver}-${CARCH}.deb"
  # A .deb is an `ar` archive of control.tar.* + data.tar.*; libarchive's bsdtar
  # reads both. Unpack the payload (data.tar.*) straight into $pkgdir.
  bsdtar -xf "${srcdir}/${deb}" -C "${srcdir}" data.tar.zst data.tar.xz data.tar.gz 2>/dev/null || bsdtar -xf "${srcdir}/${deb}" -C "${srcdir}"
  bsdtar -xf "${srcdir}"/data.tar.* -C "${pkgdir}"
}
