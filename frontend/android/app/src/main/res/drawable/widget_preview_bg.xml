<?xml version="1.0" encoding="utf-8"?>
<!-- Raised white card used as the background for widget-picker preview layouts.
     Elevation can't be drawn in a shape, so a faint warm edge stands in for it
     against the launcher wallpaper. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#FFFFFF" />
    <corners android:radius="24dp" />
    <stroke android:width="1dp" android:color="#E6DDD1" />
</shape>
