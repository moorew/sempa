<?xml version="1.0" encoding="utf-8"?>
<!-- A calm, content "resting" face for the focus widget's no-tasks state: two
     smiling closed eyes and a gentle smile, drawn in Sempa terracotta. Vector so it
     stays crisp at any widget size. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="56dp"
    android:height="56dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- Left eye (smiling arc) -->
    <path
        android:pathData="M13,19 Q18,25 23,19"
        android:strokeColor="#B3592E"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Right eye (smiling arc) -->
    <path
        android:pathData="M25,19 Q30,25 35,19"
        android:strokeColor="#B3592E"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Gentle smile -->
    <path
        android:pathData="M19,30 Q24,35 29,30"
        android:strokeColor="#B3592E"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
</vector>
