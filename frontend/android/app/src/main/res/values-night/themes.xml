<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Sempa Material 3 theme — dark -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Filled primaries use the burnt #B3592E with light text, matching the
             app's dark button fill and text pair (holds AA). The lighter #E0814F in
             themes.css is only for accent TEXT on dark surfaces. -->
        <item name="colorPrimary">#B3592E</item>
        <item name="colorOnPrimary">#FFFAF5</item>
        <item name="colorPrimaryContainer">#3A2519</item>
        <item name="colorOnPrimaryContainer">#F4EDE5</item>
        <item name="colorSurface">#14100D</item>
        <item name="colorOnSurface">#F4EDE5</item>
        <item name="colorSurfaceVariant">#221B16</item>
        <item name="colorOutline">#33281F</item>
        <item name="android:navigationBarColor">#14100D</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:navigationBarColor">#14100D</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

</resources>
