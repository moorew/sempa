<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Sempa Material 3 theme — dark -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Dark accent is the lighter #E0814F (as in themes.css); light text fails
             AA on it, so filled primaries take the dark canvas ink instead. -->
        <item name="colorPrimary">#E0814F</item>
        <item name="colorOnPrimary">#14100D</item>
        <item name="colorPrimaryContainer">#3A2519</item>
        <item name="colorOnPrimaryContainer">#F4EDE5</item>
        <item name="colorSurface">#14100D</item>
        <item name="colorOnSurface">#F4EDE5</item>
        <item name="colorSurfaceVariant">#221B16</item>
        <item name="colorOutline">#33281F</item>
        <item name="android:navigationBarColor">#14100D</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:navigationBarColor">#14100D</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

</resources>
