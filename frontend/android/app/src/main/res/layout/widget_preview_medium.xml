<?xml version="1.0" encoding="utf-8"?>
<!-- Static preview of the Today's-tasks widget shown in the home-screen picker. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_preview_bg"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Today · 2/4"
        android:textColor="#2B221B"
        android:textStyle="bold"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="○  Write the spec"
        android:textColor="#2B221B"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="○  Email triage"
        android:textColor="#2B221B"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="✓  Review PR"
        android:textColor="#B0A498"
        android:textSize="13sp" />
</LinearLayout>
