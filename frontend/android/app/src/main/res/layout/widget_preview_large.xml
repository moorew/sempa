<?xml version="1.0" encoding="utf-8"?>
<!-- Static preview of the Weekly-overview widget shown in the home-screen picker. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_preview_bg"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="This week"
        android:textColor="#2B221B"
        android:textStyle="bold"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="M  T  W  T  F  S  S"
        android:textColor="#B3592E"
        android:fontFamily="monospace"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Today · 2/4"
        android:textColor="#2B221B"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="○  Write the spec"
        android:textColor="#2B221B"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="○  Email triage"
        android:textColor="#2B221B"
        android:textSize="13sp" />
</LinearLayout>
