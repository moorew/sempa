<?xml version="1.0" encoding="utf-8"?>
<!-- A native Chronometer embedded in the Glance Pomodoro widget (via
     AndroidRemoteViews) so the countdown ticks live on the home screen with no
     per-second widget updates — the same mechanism as the ongoing notification.
     Base/colour/countdown are set at render time from RemoteViews. -->
<Chronometer xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/focus_chrono"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:textSize="28sp"
    android:textStyle="bold"
    android:fontFamily="monospace"
    android:textColor="#B3592E" />
