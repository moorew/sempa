{
  "name": "sempa-frontend",
  "version": "1.28.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "verify:ux": "node scripts/verify-sheet.mjs && node scripts/verify-dom.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@vitest/ui": "^5.0.5",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "~8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-deep-link": "^2.6.1",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-sql": "^2.6.0",
    "@tauri-apps/plugin-store": "^2.5.0",
    "lucide-svelte": "^1.0.1"
  },
  "comments": {
    "overrides": "Force patched versions of vulnerable transitive deps (all in dev/build-time tooling — Capacitor CLI, xcode project tooling, jsdom's undici under vitest, vite's postcss — none ship in the server or web bundle). Scoped to the offending parent where possible so tools needing newer majors are untouched. postcss, brace-expansion and devalue are unscoped because the vulnerable copy is nested several levels deep (vite > postcss; @capacitor/cli > rimraf > glob > minimatch > brace-expansion) and devalue is shared by svelte + @sveltejs/kit; all are backwards-compatible patch/minor bumps."
  },
  "overrides": {
    "@capacitor/cli": {
      "tar": "^7.5.19",
      "@xmldom/xmldom": "^0.9.12",
      "uuid": "^11.1.1"
    },
    "jsdom": {
      "undici": "^7.30.0"
    },
    "postcss": "^8.5.23",
    "brace-expansion": "^5.0.12",
    "devalue": "^5.9.4"
  }
}
