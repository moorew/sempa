{
  "name": "sempa-frontend",
  "version": "1.24.6",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "verify:ux": "node scripts/verify-sheet.mjs && node scripts/verify-dom.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.69.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/cli": "^2",
    "@vitest/ui": "^4.1.9",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "~8.0.16",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/splash-screen": "^8.0.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-sql": "^2",
    "@tauri-apps/plugin-store": "^2",
    "lucide-svelte": "^1.0.1"
  },
  "comments": {
    "overrides": "Force patched versions of vulnerable transitive deps (all in dev/build-time tooling — Capacitor CLI, xcode project tooling, jsdom's undici under vitest, vite's postcss — none ship in the server or web bundle). Scoped to the offending parent where possible so tools needing newer majors are untouched. postcss and brace-expansion are unscoped because the vulnerable copy is nested several levels deep (vite > postcss; @capacitor/cli > rimraf > glob > minimatch > brace-expansion) and both are backwards-compatible patch bumps."
  },
  "overrides": {
    "@capacitor/cli": {
      "tar": "^7.5.19"
    },
    "@sveltejs/kit": {
      "cookie": "^0.7.0"
    },
    "jsdom": {
      "undici": "^7.28.0"
    },
    "postcss": "^8.5.23",
    "brace-expansion": "^5.0.8"
  }
}
